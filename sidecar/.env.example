OPENBOXES_URL=http://localhost/openboxes
OPENBOXES_USERNAME=vegath-agent
OPENBOXES_PASSWORD=
OPENBOXES_LOCATION_ID=
# Admin credentials are used only by seed.py, never by the runtime bot.
OPENBOXES_ADMIN_USERNAME=
OPENBOXES_ADMIN_PASSWORD=
# Optional API-key header for deployments with an authentication gateway.
# This checkout natively uses /api/login session cookies, not API keys.
OPENBOXES_API_KEY=
OPENBOXES_API_KEY_HEADER=X-API-Key
EASYPOST_API_KEY=
SHIPPO_API_KEY=
SHIPPO_CARRIER=shippo
BROWSER_EXECUTABLE_PATH=
BROWSER_CDP_URL=
PORTAL_ALLOWED_ORIGINS=http://localhost:8080
# llm is the normal mode; rules is an explicit offline/replay alternative.
CONTEXT_MODE=llm
LLM_CHAT_URL=
LLM_API_KEY=
LLM_MODEL=
CARRIER_FIXTURES=false
SIDECAR_STATE_PATH=sidecar.sqlite3
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=dunder-mifflin-paper-co-shipment@agentmail.to
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
RECALL_MODEL=deepseek/deepseek-v4-flash-0731
IMAGE_MODEL=openai/gpt-4.1-mini
TOW_RESEARCH_MODEL=openai/gpt-4.1-mini
# Optional broader recall web search and higher-rate FDA API access.
BRAVE_SEARCH_API_KEY=
OPENFDA_API_KEY=
# Optional path to a separate file containing AgentMail/OpenRouter keys.
SHIPMENT_EMAIL_ENV_FILE=
# During synthetic tests, outbound messages are limited to this comma-separated set.
CARRIER_TEST_RECIPIENTS=

# Hours before an unanswered shipment contact (driver, sending warehouse, or
# shipment company) or recovery carrier is asked the same thing again.
CONTACT_FOLLOW_UP_HOURS=4
CARRIER_FOLLOW_UP_HOURS=2

# Background follow-up of unanswered contacts on shipments that are late or due
# within 24 hours. Each run reads the threads, sends at most one follow-up per
# contact per window, and records every outcome on the OpenBoxes shipment.
CONTACT_AUTO_CHASE=true
CONTACT_AUTO_FOLLOW_UP_LIMIT=2
CONTACT_MONITOR_INTERVAL_MINUTES=10
