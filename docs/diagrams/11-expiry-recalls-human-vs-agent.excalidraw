  {
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "id": "h_scale_text",
   "type": "text",
   "x": 40,
   "y": 1014,
   "width": 920,
   "height": 38,
   "strokeColor": "#374151",
   "text": "Recall checks across many products and sites need trained, careful\npeople, and a recall does not wait for the next free afternoon.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "id": "a_scale_text",
   "type": "text",
   "x": 1020,
   "y": 1014,
   "width": 920,
   "height": 38,
   "strokeColor": "#374151",
   "text": "Every lot is checked against the notice the same way, the\nmoment someone asks.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "id": "h_legend",
   "type": "text",
   "x": 40,
   "y": 1060,
   "width": 920,
   "height": 18,
   "strokeColor": "#c2410c",
   "text": "Each person hired, trained and kept. Knowledge leaves with them.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "id": "a_legend",
   "type": "text",
   "x": 1020,
   "y": 1060,
   "width": 920,
   "height": 18,
   "strokeColor": "#6d28d9",
   "text": "One agent, same rules everywhere. People approve; each approval is quick.",
   "fontSize": 14,
