  {
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "id": "h_scale_text",
   "type": "text",
   "x": 40,
   "y": 1014,
   "width": 920,
   "height": 38,
   "strokeColor": "#374151",
   "text": "More lanes and carriers means more hours in the inbox, and the context\nlives in one coordinator's head.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "id": "a_scale_text",
   "type": "text",
   "x": 1020,
   "y": 1014,
   "width": 920,
   "height": 38,
   "strokeColor": "#374151",
   "text": "Any shipment's story is rebuilt on request, with the emails\nit came from.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "id": "h_legend",
   "type": "text",
   "x": 40,
   "y": 1060,
   "width": 920,
   "height": 18,
   "strokeColor": "#c2410c",
   "text": "Each person hired, trained and kept. Knowledge leaves with them.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "id": "a_legend",
   "type": "text",
   "x": 1020,
   "y": 1060,
   "width": 920,
   "height": 18,
   "strokeColor": "#6d28d9",
   "text": "One agent, same rules everywhere. People approve; each approval is quick.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "id": "stays_human",
   "type": "text",
   "x": 40,
   "y": 1105,
   "width": 1920,
   "height": 38,
   "strokeColor": "#64748b",
   "text": "WHAT STAYS HUMAN: approving every change, supplier and carrier relationships, and judgment on anything new or unusual.\nThe agent is only as good as the OpenBoxes records it reads.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "id": "tagline",
   "type": "text",
   "x": 40,
   "y": 1160,
   "width": 1920,
   "height": 30,
   "strokeColor": "#1e40af",
   "text": "The agent finds and reads. The coordinator decides and dispatches.",
   "fontSize": 24,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25
  }
