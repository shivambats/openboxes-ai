  {
   "id": "text_27",
   "type": "text",
   "x": 40,
   "y": 405,
   "width": 400,
   "height": 27,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "text": "1  Notice",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "id": "text_28",
   "type": "text",
   "x": 40,
   "y": 440,
   "width": 400,
   "height": 40,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "text": "SHIP-2026-BOX1 is 19 days\npast its delivery date.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "id": "text_29",
   "type": "text",
   "x": 480,
   "y": 405,
   "width": 400,
   "height": 27,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "text": "2  Understand",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "id": "text_30",
   "type": "text",
   "x": 480,
   "y": 440,
   "width": 400,
   "height": 60,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "text": "Reads the warehouse reply,\n\"should reach by noon today\",\nand works out that meant 13 Oct.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "id": "text_31",
   "type": "text",
   "x": 920,
   "y": 405,
   "width": 400,
   "height": 27,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "text": "3  Decide",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "id": "text_32",
   "type": "text",
   "x": 920,
   "y": 440,
   "width": 400,
   "height": 60,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "text": "A reply already came in, so\nanother email adds nothing.\nTell the operator, then wait.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "id": "text_33",
   "type": "text",
   "x": 1360,
   "y": 405,
   "width": 400,
   "height": 27,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "text": "4  Act, safely",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "id": "text_34",
   "type": "text",
   "x": 1360,
   "y": 440,
   "width": 400,
   "height": 60,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "text": "Records the reply on the\nshipment. Chases again only\nif no answer within 4 hours.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
