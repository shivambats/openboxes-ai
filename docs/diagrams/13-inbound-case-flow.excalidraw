   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "id": "autonomy",
   "type": "text",
   "x": 40,
   "y": 1670,
   "width": 2250,
   "height": 19,
   "strokeColor": "#64748b",
   "text": "Amber steps need your approval today. Chasing and applying a quoted date can become automatic only after shadow mode and business sign-off. Cancelling, changing or dispatching never does.",
   "originalText": "Amber steps need your approval today. Chasing and applying a quoted date can become automatic only after shadow mode and business sign-off. Cancelling, changing or dispatching never does.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
