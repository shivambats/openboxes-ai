  {
   "id": "ev_card_t",
   "type": "text",
   "x": 1022,
   "y": 748,
   "width": 750,
   "height": 130,
   "text": "expected_delivery : 24 Sep 2026   status: 19 days past SLA\nwarehouse_reply   : \"On its way, should reach by noon today\"\nreply_seen        : no, it sat unread in the inbox\nnext_action_taken : same status request emailed again\nresult            : duplicate outreach, no new information",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#22c55e",
   "backgroundColor": "transparent",
   "roughness": 0,
   "opacity": 100
  },
  {
   "id": "punch",
   "type": "text",
   "x": 40,
   "y": 930,
   "width": 1750,
   "height": 56,
   "text": "The cost is not the delay alone. It is the time, money and customer trust spent finding the exception,\nchasing it and deciding what to do, plus the decisions that never get written down.",
   "fontSize": 20,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "roughness": 0,
   "opacity": 100
  },
