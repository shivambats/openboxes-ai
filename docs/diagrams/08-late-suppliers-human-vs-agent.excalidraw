   "type": "text",
   "x": 40,
   "y": 1160,
   "width": 1920,
   "height": 30,
   "strokeColor": "#1e40af",
   "text": "The agent never forgets a follow-up and never chases twice. The buyer keeps the relationship.",
   "fontSize": 24,
