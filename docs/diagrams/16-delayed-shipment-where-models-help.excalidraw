  },
  {
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "id": "know_body_59",
   "type": "text",
   "x": 120,
   "y": 990,
   "width": 1800,
   "height": 38,
   "strokeColor": "#374151",
   "text": "Run in shadow mode first, on our own orders, and compare with the manual way: hours from late to noticed \u00b7 messages per\nlate order \u00b7 expedite spend \u00b7 OTIF fines \u00b7 requests that went short. We claim no savings until shadow mode measures them.",
   "originalText": "Run in shadow mode first, on our own orders, and compare with the manual way: hours from late to noticed \u00b7 messages per\nlate order \u00b7 expedite spend \u00b7 OTIF fines \u00b7 requests that went short. We claim no savings until shadow mode measures them.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25
  },
  {
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "id": "tagline_60",
   "type": "text",
   "x": 40,
   "y": 1060,
   "width": 1920,
   "height": 30,
   "strokeColor": "#1e40af",
   "text": "Models read and judge. Rules check and write. People approve. Each one cuts a different line of the bill.",
   "originalText": "Models read and judge. Rules check and write. People approve. Each one cuts a different line of the bill.",
   "fontSize": 24,
   "fontFamily": 3,
   "textAlign": "left",
