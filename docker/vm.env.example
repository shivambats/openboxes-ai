# Copy to vm.env on the VM and fill in. vm.env is git-ignored; never commit it.
# Public hostname; its DNS A record must point at the VM before first start.
DOMAIN=openboxes.example.com

# Database passwords. Generate with: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
DATASOURCE_PASSWORD=

# Shared secret between OpenBoxes and the sidecar. Generate with: openssl rand -hex 32
OPENBOXES_SIDECAR_TOKEN=

# true only while running seed.py or seeding demo shipments.
SIDECAR_SANDBOX_ENABLED=false
