# Copy to sidecar.vm.env on the VM and fill in. It is git-ignored; never commit it.
# OPENBOXES_URL, the sidecar token and the state path are set by docker-compose-vm.yml.

# Runtime bot account in OpenBoxes (created by seed.py; 16+ characters).
OPENBOXES_USERNAME=vegath-agent
OPENBOXES_PASSWORD=
OPENBOXES_LOCATION_ID=
# Used only by seed.py. Change the stock OpenBoxes admin password first.
OPENBOXES_ADMIN_USERNAME=admin
OPENBOXES_ADMIN_PASSWORD=

# Models and mail.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
RECALL_MODEL=deepseek/deepseek-v4-flash-0731
IMAGE_MODEL=openai/gpt-4.1-mini
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
BRAVE_SEARCH_API_KEY=
OPENFDA_API_KEY=

# Outgoing carrier email is only allowed to these addresses.
CARRIER_TEST_RECIPIENTS=

CONTEXT_MODE=llm
CARRIER_FIXTURES=false
CONTACT_AUTO_CHASE=true
